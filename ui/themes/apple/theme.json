{
  "name": "Apple",
  "version": "1.0.0",
  "description": "Quiet, product-page elegance: frosted navigation, oversized headlines, airy grids and San Francisco-style typography.",
  "author": "sap13ns",
  "license": "MIT",
  "menus": [
    {"id": "primary", "label": "Main menu"},
    {"id": "footer", "label": "Footer menu"}
  ],
  "widget_areas": [
    {"id": "top", "label": "Top bar", "description": "A full-width strip above the header, for announcements."},
    {"id": "footer", "label": "Footer", "description": "Columns above the footer line."}
  ],
  "options": [
    {"key": "hero", "label": "Show the large introduction on the homepage", "type": "bool", "default": "true"},
    {"key": "hero_title", "label": "Introduction headline", "type": "text", "default": "", "help": "Empty uses the site title."},
    {"key": "accent", "label": "Accent colour", "type": "select", "default": "blue", "choices": [
      {"value": "blue", "label": "Blue"}, {"value": "indigo", "label": "Indigo"}, {"value": "green", "label": "Green"},
      {"value": "orange", "label": "Orange"}, {"value": "pink", "label": "Pink"}, {"value": "graphite", "label": "Graphite"}
    ]}
  ],
  "tokens": {
    "light": {"background": "#ffffff", "foreground": "#1d1d1f", "card": "#f5f5f7", "card-foreground": "#1d1d1f", "muted": "#f5f5f7", "muted-foreground": "#6e6e73", "border": "#d2d2d7", "primary": "#0071e3", "primary-foreground": "#ffffff", "accent": "#f5f5f5", "accent-foreground": "#171717"},
    "dark": {"background": "#000000", "foreground": "#f5f5f7", "card": "#1c1c1e", "card-foreground": "#f5f5f7", "muted": "#1c1c1e", "muted-foreground": "#a1a1a6", "border": "#38383a", "primary": "#2997ff", "primary-foreground": "#ffffff", "accent": "#404040", "accent-foreground": "#fafafa"},
    "options": {
      "accent": {
        "indigo": {"light": {"primary": "#5e5ce6"}, "dark": {"primary": "#7d7aff"}},
        "green": {"light": {"primary": "#1d8f3a"}, "dark": {"primary": "#30d158"}},
        "orange": {"light": {"primary": "#e8590c"}, "dark": {"primary": "#ff9f0a"}},
        "pink": {"light": {"primary": "#d6336c"}, "dark": {"primary": "#ff375f"}},
        "graphite": {"light": {"primary": "#1d1d1f"}, "dark": {"primary": "#f5f5f7", "primary-foreground": "#000000"}}
      }
    }
  },
  "swatches": ["#f5f5f7", "#ffffff", "#1d1d1f", "#0071e3"]
}
