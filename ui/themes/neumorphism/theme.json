{
  "name": "Neumorphism",
  "version": "1.0.0",
  "description": "Soft UI: every card, button and field is extruded from or carved into one continuous surface, with accessible contrast and clear focus rings in light and dark.",
  "author": "sap13ns",
  "license": "MIT",
  "menus": [
    {"id": "primary", "label": "Main menu"},
    {"id": "footer", "label": "Footer menu"}
  ],
  "widget_areas": [
    {"id": "top", "label": "Top bar", "description": "A full-width strip above the header, for announcements."},
    {"id": "sidebar", "label": "Sidebar", "description": "Soft panels beside the post listings (below them on small screens)."},
    {"id": "footer", "label": "Footer", "description": "Columns inside the carved footer tray."}
  ],
  "options": [
    {"key": "accent", "label": "Accent colour", "type": "select", "default": "iris", "help": "Used for links, focus rings and the primary button.", "choices": [
      {"value": "iris", "label": "Iris"}, {"value": "teal", "label": "Teal"}, {"value": "rose", "label": "Rose"},
      {"value": "amber", "label": "Amber"}, {"value": "sage", "label": "Sage"}, {"value": "slate", "label": "Slate"}
    ]},
    {"key": "depth", "label": "Shadow depth", "type": "select", "default": "soft", "help": "How far raised elements stand out from the surface.", "choices": [
      {"value": "subtle", "label": "Subtle"}, {"value": "soft", "label": "Soft"}, {"value": "deep", "label": "Deep"}
    ]},
    {"key": "hero", "label": "Show the soft introduction panel on the homepage", "type": "bool", "default": "true"},
    {"key": "hero_title", "label": "Introduction headline", "type": "text", "default": "", "help": "Empty uses the site title."},
    {"key": "card_images", "label": "Show featured images in post cards", "type": "bool", "default": "true"},
    {"key": "sidebar", "label": "Show the sidebar next to post listings", "type": "bool", "default": "true"}
  ],
  "tokens": {
    "light": {"background": "#e6e9ef", "foreground": "#262d3a", "card": "#e6e9ef", "card-foreground": "#262d3a", "muted": "#dfe3ea", "muted-foreground": "#4f596b", "border": "#cbd1dc", "primary": "#4750b0", "primary-foreground": "#f4f6fa", "accent": "#dfe3ea", "accent-foreground": "#262d3a"},
    "dark": {"background": "#1f2329", "foreground": "#e4e8ef", "card": "#1f2329", "card-foreground": "#e4e8ef", "muted": "#1a1d22", "muted-foreground": "#a3acba", "border": "#30353e", "primary": "#a3abff", "primary-foreground": "#16191e", "accent": "#1a1d22", "accent-foreground": "#e4e8ef"},
    "options": {
      "accent": {
        "teal": {"light": {"primary": "#11686f"}, "dark": {"primary": "#6fcacb"}},
        "rose": {"light": {"primary": "#a23a5f"}, "dark": {"primary": "#f39bba"}},
        "amber": {"light": {"primary": "#82500a"}, "dark": {"primary": "#e8b665"}},
        "sage": {"light": {"primary": "#2f6a45"}, "dark": {"primary": "#90d1a3"}},
        "slate": {"light": {"primary": "#3c4a5e"}, "dark": {"primary": "#c3cedc"}}
      }
    }
  },
  "swatches": ["#e6e9ef", "#1f2329", "#262d3a", "#4750b0"]
}
