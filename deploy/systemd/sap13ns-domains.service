# Gives every custom domain of the sap13ns network a certificate and an
# nginx server block (/usr/local/sbin/sap13ns-domains). It runs as root
# because it writes nginx's configuration, runs certbot and reloads nginx,
# none of which the web server may do. Started by sap13ns-domains.path when
# the list changes and by sap13ns-domains.timer every hour (retries).
# Logs: `journalctl -u sap13ns-domains`.

[Unit]
Description=HTTPS for the custom domains of the sap13ns network
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sap13ns-domains
TimeoutStartSec=15min
SyslogIdentifier=sap13ns-domains
PrivateTmp=yes
ProtectHome=yes
