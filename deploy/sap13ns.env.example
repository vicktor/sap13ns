# /etc/sap13ns/sap13ns.env (root:sap13ns 0640). Every variable has the
# SAP13NS_ prefix; see README.md for the full list.

# PostgreSQL over its local socket, as the sap13ns role.
SAP13NS_DATABASE_URL=postgres:///sap13ns?host=/run/postgresql

# 32+ random bytes from `sap13ns keygen`. It encrypts stored API keys and
# signs sessions and tokens: changing it signs everyone out and makes
# stored keys and passkeys unusable. Keep a copy somewhere safe.
SAP13NS_SECRET_KEY=

# The public address of the site.
SAP13NS_BASE_URL=https://example.com

# Behind nginx (deploy/nginx/sap13ns.conf).
SAP13NS_LISTEN=unix:/run/sap13ns/sap13ns.sock
SAP13NS_SOCKET_GROUP=sap13ns-web
SAP13NS_DATA_DIR=/var/lib/sap13ns

# Outgoing e-mail (password resets, notifications).
#SAP13NS_SMTP_HOST=smtp.example.com
#SAP13NS_SMTP_PORT=587
#SAP13NS_SMTP_USERNAME=
#SAP13NS_SMTP_PASSWORD=
#SAP13NS_SMTP_FROM=sap13ns <no-reply@example.com>

# Limits and logging.
#SAP13NS_MAX_UPLOAD_MB=16
#SAP13NS_DB_MAX_CONNS=16
#SAP13NS_LOG_LEVEL=info
SAP13NS_LOG_FORMAT=json

# Encrypted backups (sap13ns backup, deploy/systemd/sap13ns-backup.*).
#SAP13NS_BACKUP_DIR=/var/lib/sap13ns/backups
#SAP13NS_BACKUP_PASSPHRASE_FILE=/etc/sap13ns/backup-passphrase
#SAP13NS_BACKUP_KEEP_DAILY=7
#SAP13NS_BACKUP_KEEP_WEEKLY=4
#SAP13NS_BACKUP_KEEP_MONTHLY=12
# The site's own archives (Tools → Backups, backup -format site), in
# <BACKUP_DIR>/site, or <BACKUP_DIR>/sites/<id> on a network. The server
# reads the passphrase too, to encrypt what it makes.
#SAP13NS_SITE_BACKUP_KEEP_DAILY=7
#SAP13NS_SITE_BACKUP_KEEP_WEEKLY=4

# Daily check for new releases (shown to administrators).
#SAP13NS_UPDATE_CHECK=true

# A network of sites (docs/MULTISITE.md): the BASE_URL host is the portal,
# and sites get <slug>.<SITES_DOMAIN>. Run `sap13ns network init` once
# before the first start. The nginx wildcard setup is in docs/DEPLOY.md.
#SAP13NS_MULTISITE=true
#SAP13NS_SITES_DOMAIN=example.com
#SAP13NS_UNKNOWN_HOST=404
#SAP13NS_MAX_LOADED_SITES=50
#SAP13NS_SITE_IDLE=15m
#SAP13NS_MEMORY_LIMIT_MB=0
# Custom domains point here with a CNAME, or to these addresses.
#SAP13NS_DOMAIN_TARGET=example.com
#SAP13NS_DOMAIN_ADDRESSES=192.0.2.10,2001:db8::10
# Every night, a backup of each active or suspended site, a few at a time;
# what the time budget leaves comes first the next night.
#SAP13NS_SITE_BACKUPS=true
#SAP13NS_SITE_BACKUP_TIME=03:30
#SAP13NS_SITE_BACKUP_CONCURRENCY=2
#SAP13NS_SITE_BACKUP_BUDGET=3h
# proxy: nginx or Caddy terminate TLS. autocert needs a TCP listener
# (SAP13NS_LISTEN=:443) and the variables in docs/MULTISITE.md.
#SAP13NS_TLS=proxy
# Billing (docs/BILLING.md).
#SAP13NS_STRIPE_SECRET_KEY=
#SAP13NS_STRIPE_WEBHOOK_SECRET=
#SAP13NS_STRIPE_PRICE_PRO=
#SAP13NS_STRIPE_PRICE_BUSINESS=
