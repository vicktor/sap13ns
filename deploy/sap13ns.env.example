# /etc/sap13ns/sap13ns.env (root:sap13ns 0640). Every variable has the
# SAP13NS_ prefix; see README.md for the full list.

# PostgreSQL over its local socket, as the sap13ns role.
SAP13NS_DATABASE_URL=postgres:///sap13ns?host=/run/postgresql

# 32+ random bytes from `sap13ns keygen`. It encrypts stored API keys and
# signs sessions and tokens: changing it signs everyone out and makes
# stored keys and passkeys unusable. Keep a copy somewhere safe.
SAP13NS_SECRET_KEY=

# The public address of the site.
SAP13NS_BASE_URL=https://example.com

# Behind nginx (deploy/nginx/sap13ns.conf).
SAP13NS_LISTEN=unix:/run/sap13ns/sap13ns.sock
SAP13NS_SOCKET_GROUP=sap13ns-web
SAP13NS_DATA_DIR=/var/lib/sap13ns

# Outgoing e-mail (password resets, notifications).
#SAP13NS_SMTP_HOST=smtp.example.com
#SAP13NS_SMTP_PORT=587
#SAP13NS_SMTP_USERNAME=
#SAP13NS_SMTP_PASSWORD=
#SAP13NS_SMTP_FROM=sap13ns <no-reply@example.com>

# Limits and logging.
#SAP13NS_MAX_UPLOAD_MB=16
#SAP13NS_DB_MAX_CONNS=16
#SAP13NS_LOG_LEVEL=info
SAP13NS_LOG_FORMAT=json

# Encrypted backups (sap13ns backup, deploy/systemd/sap13ns-backup.*).
#SAP13NS_BACKUP_DIR=/var/lib/sap13ns/backups
#SAP13NS_BACKUP_PASSPHRASE_FILE=/etc/sap13ns/backup-passphrase
#SAP13NS_BACKUP_KEEP_DAILY=7
#SAP13NS_BACKUP_KEEP_WEEKLY=4
#SAP13NS_BACKUP_KEEP_MONTHLY=12

# Daily check for new releases (shown to administrators).
#SAP13NS_UPDATE_CHECK=true
