{
  "name": "sap13ns-assets",
  "private": true,
  "type": "module",
  "description": "Build-time frontend assets for sap13ns (Tailwind CSS, Basecoat UI, Lucide icons). Nothing here ships to production as Node: outputs are embedded in the Go binary.",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "watch": "node scripts/build-assets.mjs --watch",
    "test": "node --test ui/admin/test/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tailwindcss/cli": "4.3.3",
    "basecoat-css": "1.0.2",
    "esbuild": "0.28.2",
    "lucide-static": "1.59.0",
    "tailwindcss": "4.3.3",
    "world-atlas": "2.0.2"
  }
}
